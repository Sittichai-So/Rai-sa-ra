# Frontend (Nuxt 2). ปกติไม่ต้องมีไฟล์นี้ตอน dev — nuxt ตั้ง NODE_ENV ให้เอง
# ใส่ค่าพวกนี้เฉพาะตอน build/deploy production

# URL ของ backend API (ลงท้าย /api/raisara)
API_BASE=http://localhost:8012/api/raisara

# origin ของ backend (ใช้ต่อ socket + โหลดรูปจาก /uploads)
API_FILE_BASE=http://localhost:8012

# ถ้า socket อยู่คนละที่กับ API_FILE_BASE ค่อยตั้งอันนี้
# SOCKET_URL=http://localhost:8012
